# ==========================================

# Application

# ==========================================

APP_NAME=AgentHub
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ==========================================

# Security

# ==========================================

# HS256 要求密钥至少 32 字节，生产环境务必更换为随机密钥
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================

# MySQL

# ==========================================

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agenthub
MYSQL_USER=agenthub
MYSQL_PASSWORD=change-me

# 统一使用 asyncmy 异步驱动（requirements.txt 中已安装依赖）
DATABASE_URL=mysql+asyncmy://agenthub:change-me@localhost:3306/agenthub

# ==========================================

# Redis

# ==========================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

REDIS_URL=redis://localhost:6379/0

# ==========================================

# Qdrant

# ==========================================

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

QDRANT_URL=http://localhost:6333

# ==========================================

# LLM（OpenAI 兼容协议；模型名由 Agent 版本的 model_name 决定，此处仅配置网关）

# ==========================================

LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=your-api-key
LLM_TIMEOUT_SECONDS=60

# ==========================================

# Embedding

# ==========================================

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1

# ==========================================

# Storage

# ==========================================

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=20

# ==========================================

# CORS

# ==========================================

CORS_ORIGINS=http://localhost:5173

# ==========================================

# Worker

# ==========================================

WORKER_CONCURRENCY=2
DOCUMENT_PROCESSING_TIMEOUT=300
