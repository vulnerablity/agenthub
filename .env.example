# ==========================================
# AgentHub 环境配置模板
# 字段名与 backend/app/core/config.py 一一对应；修改后复制为根目录 .env：
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux/macOS:         cp .env.example .env
# 本地直接运行后端时 config.py 优先读 backend/.env（本机数据库凭据），请同步两处。
# ==========================================

# ==========================================
# Application
# ==========================================

APP_NAME=AgentHub
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ==========================================
# Security
# ==========================================

# HS256 要求密钥至少 32 字节，生产环境务必更换为随机密钥
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# MySQL（docker compose 创建 agenthub 用户）
# ==========================================

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agenthub
MYSQL_USER=agenthub
MYSQL_PASSWORD=change-me

# 统一使用 asyncmy 异步驱动（requirements.txt 中已安装依赖）
# 注意：DATABASE_URL 必须与上方 MYSQL_* 保持一致
DATABASE_URL=mysql+asyncmy://agenthub:change-me@localhost:3306/agenthub

# ==========================================
# Redis（REDIS_HOST/PORT/PASSWORD/DB 仅供部署编排参考，运行时以 REDIS_URL 为准）
# ==========================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

REDIS_URL=redis://localhost:6379/0

# ==========================================
# Qdrant
# ==========================================

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ==========================================
# LLM（OpenAI 兼容协议；模型名由 Agent 版本的 model_name 决定，此处仅配置网关）
# LLM_API_BASE / LLM_API_KEY 必填，否则 LLM 对话与 RAG 不可用
# ==========================================

LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=your-api-key
LLM_TIMEOUT_SECONDS=60
CHAT_HISTORY_LIMIT=20

# ==========================================
# Embedding（OpenAI 兼容 /embeddings；未配置时回落 LLM 网关与密钥）
# ==========================================

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=32

# ==========================================
# Storage（知识库文档上传）
# ==========================================

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=20

# ==========================================
# RAG
# ==========================================

RAG_DEFAULT_TOP_K=5

# ==========================================
# CORS
# ==========================================

CORS_ORIGINS=http://localhost:5173

# ==========================================
# Worker
# ==========================================

WORKER_CONCURRENCY=2
DOCUMENT_PROCESSING_TIMEOUT=300
